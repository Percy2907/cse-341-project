{
  "swagger": "2.0",
  "info": {
    "title": "Contacts & Companies API",
    "description": "CRUD API for contacts and companies",
    "version": "1.0.0"
  },
  "host": "cse-341-project-bq0q.onrender.com",
  "basePath": "/",
  "schemes": ["http", "https"],
  "paths": {
    "/contacts/": {
      "get": {
        "description": "Get all contacts",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Server Error" }
        }
      },
      "post": {
        "description": "Create a new contact",
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "example": "John" },
                "lastName": { "example": "Doe" },
                "email": { "example": "john@example.com" },
                "favoriteColor": { "example": "Blue" },
                "birthday": { "example": "1990-01-01" }
              },
              "required": ["firstName", "lastName", "email"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "description": "Get a single contact by ID",
        "produces": ["application/json"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      },
      "put": {
        "description": "Update a contact by ID",
        "consumes": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "firstName": { "example": "John" },
                "lastName": { "example": "Doe" },
                "email": { "example": "john@example.com" },
                "favoriteColor": { "example": "Blue" },
                "birthday": { "example": "1990-01-01" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      },
      "delete": {
        "description": "Delete a contact by ID",
        "produces": ["application/json"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/companies/": {
      "get": {
        "description": "Get all companies",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Server Error" }
        }
      },
      "post": {
        "description": "Create a new company",
        "consumes": ["application/json"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "example": "Acme Corp" },
                "industry": { "example": "Technology" },
                "email": { "example": "contact@acme.com" },
                "phone": { "example": "+1-555-1234" },
                "address": { "example": "123 Main St" },
                "city": { "example": "Lima" },
                "state": { "example": "Lima" }
              },
              "required": ["name", "industry", "email"]
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Server Error" }
        }
      }
    },
    "/companies/{id}": {
      "get": {
        "description": "Get a single company by ID",
        "produces": ["application/json"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      },
      "put": {
        "description": "Update a company by ID",
        "consumes": ["application/json"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "example": "Acme Corp" },
                "industry": { "example": "Technology" },
                "email": { "example": "contact@acme.com" },
                "phone": { "example": "+1-555-1234" },
                "address": { "example": "123 Main St" },
                "city": { "example": "Lima" },
                "state": { "example": "Lima" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Updated successfully" },
          "400": { "description": "Bad Request" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      },
      "delete": {
        "description": "Delete a company by ID",
        "produces": ["application/json"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "type": "string" }],
        "responses": {
          "200": { "description": "Deleted successfully" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server Error" }
        }
      }
    }
  }
}